# /opt/autorun/autoprov.env
# URL del bootstrap (usa *raw*, no la página HTML de GitHub)
GITHUB_BOOTSTRAP_URL="https://raw.githubusercontent.com/MarcPineiro/serverUtils/main/check-so/autoinstall-ubuntu.sh"

# Timeout total de espera de red (segundos)
NET_WAIT_SECONDS="25"

# Si 1, no vuelve a ejecutarse si ya existe el flag
RUN_ONCE="1"

# Donde guardar el flag (en /tce si existe)
RUN_ONCE_FLAG_REL="autoprov/ran.ok"

# Script local de fallback (incluido en el USB dentro de mydata.tgz; se
# restaura en esta misma ruta por la persistencia de Tiny Core)
FALLBACK_SCRIPT="/opt/autorun/bootstrap.fallback.sh"

# Extra args opcionales para tu bootstrap
BOOTSTRAP_ARGS=""

# SHA-256 esperado del script descargado (opcional; vacio = no se verifica).
# Si se define, una descarga que no coincida se descarta y se considera
# fallo (se reintenta / se usa el fallback).
BOOTSTRAP_SHA256=""

# Reintentos de descarga acotados y espera entre intentos (segundos).
DOWNLOAD_RETRIES="3"
DOWNLOAD_RETRY_DELAY="5"
